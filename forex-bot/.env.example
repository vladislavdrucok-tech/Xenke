# Скопіюйте цей файл у .env і впишіть свої ключі. Файл .env не потрапляє в git.
# Без ключів бот працює в ДЕМО-режимі (згенеровані курси й новини).

# Котирування EUR/USD, GBP/USD, EUR/GBP — безкоштовний ключ на twelvedata.com
TWELVEDATA_API_KEY=

# Аналіз новин — ключ API Anthropic (console.anthropic.com). Оплата за використання.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Коли приймати рішення (UTC). Денна свічка форексу закривається о 00:00 UTC.
DECISION_TIME_UTC=00:20

# Віртуальний рахунок і ризик
START_EQUITY=10000
RISK_PER_TRADE_PCT=1
MAX_LEVERAGE=1
MAX_DRAWDOWN_PCT=10
STOP_ATR=1.5
TAKE_ATR=3
MIN_SCORE=0.15

# Додаткові RSS-стрічки новин через кому (необов'язково)
# NEWS_FEEDS=https://example.com/rss.xml

# FX_DEMO=1   # примусово демо, навіть якщо ключі є
# PORT=5174
