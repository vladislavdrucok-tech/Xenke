class_name StoryData
extends RefCounted
## The main storyline. A line is [speaker, uk, en]; "" speaker is narration.
## A choice is {"choice": [option...]}; each option has uk/en text, variable
## changes ("set"), follow-up lines ("then") and an optional letter that
## arrives in the mailbox later. Story never blocks the endless game.

const CHAPTERS := [
	{"id": "prologue", "req": {}, "title": ["Пролог: Відділення №404", "Prologue: Office No. 404"], "met": ["future"],
		"lines": [
			["", "2038 рік. Листів майже ніхто не пише: усе вирішують алгоритми й центральний ШІ — ОРАКУЛ.", "The year 2038. Hardly anyone writes letters: algorithms and the central AI, the ORACLE, decide everything."],
			["", "Тобі дістається старе поштове відділення №404. Без вивіски, без клієнтів і з дивним гулом у підвалі.", "You inherit old post office No. 404. No sign, no customers, and a strange hum in the basement."],
			["", "Щойно ти вмикаєш світло, конвеєр оживає сам. На стрічці — посилка. Відправник: «Ти, 2057».", "The moment you switch on the light, the conveyor starts by itself. A parcel. Sender: \"You, 2057\"."],
			["future", "Привіт. Це ти. Тобто я. Пишу з 2057-го.", "Hi. It's you. Well, me. Writing from 2057."],
			["future", "Не лякайся: ця пошта сортує посилки між часами. Ліворуч — минуле. Праворуч — майбутнє.", "Don't panic: this office sorts parcels between times. Left is the past. Right is the future."],
			["future", "Дивися на рік на етикетці. Сьогодні 2038-й. Решту зрозумієш — ти завжди розумієш.", "Look at the year on the label. Today is 2038. You'll figure out the rest — you always do."],
			["future", "І ще одне. Не довіряй ОРАКУЛУ. Знайди в підвалі старого робота.", "One more thing. Don't trust the ORACLE. Find the old robot in the basement."],
		]},
	{"id": "rusty", "req": {"shifts": 1}, "title": ["Глава 1: Іржавий друг", "Chapter 1: A Rusty Friend"], "met": ["bit"],
		"reward": {"coins": 120},
		"lines": [
			["", "У підвалі, під горою бандеролей 1999 року, щось блимає червоним.", "In the basement, under a heap of 1999 parcels, something blinks red."],
			["bit", "...пііп... ЗАВАНТАЖЕННЯ 3%... Хто посмів вимкнути мене у 2011-му?!", "...beep... BOOTING 3%... Who dared switch me off in 2011?!"],
			["hero", "Привіт! Тепер я керую цією поштою.", "Hi! I run this post office now."],
			["bit", "Керуєте? Ха. Цією поштою ніхто не керує. Вона керує вами.", "Run it? Ha. Nobody runs this office. It runs you."],
			["bit", "Я — БІТ, поштовий робот моделі П-404. Шестерні іржаві, пам'ять — як решето, характер — бездоганний.", "I am BIT, postal robot model P-404. Rusty gears, memory like a sieve, flawless personality."],
			["bit", "Полагодьте мене — і я допомагатиму. Шукайте «Ремонт БІТа» серед покращень.", "Repair me and I'll help. Look for \"Repair BIT\" among the upgrades."],
		]},
	{"id": "wake", "req": {"upgrade": ["robot", 1]}, "title": ["Глава 2: Шви часу", "Chapter 2: Seams of Time"],
		"reward": {"shards": 1}, "set": {"memory": 1},
		"lines": [
			["bit", "Систему відновлено на 34%. Отже, я вже розумніший за середній тостер.", "System restored to 34%. So I'm already smarter than an average toaster."],
			["bit", "Слухайте, Шефе. Ці посилки не мали б сюди приходити. Їх проштовхує крізь «шви» часу.", "Listen, Boss. These parcels shouldn't come here. They slip through the \"seams\" of time."],
			["bit", "А шви з'являються там, де ОРАКУЛ щось стер.", "And seams appear wherever the ORACLE has erased something."],
			["hero", "Стер? Що саме?", "Erased? Erased what?"],
			["bit", "Майбутнє. Ті шматочки, що йому не подобаються. Він називає це «оптимізацією».", "The future. The bits it doesn't like. It calls that \"optimisation\"."],
			["bit", "Я спробую пригадати більше. Мені потрібні деталі. І мастило. І трохи поваги.", "I'll try to remember more. I need parts. And oil. And a little respect."],
		]},
	{"id": "olena", "req": {"shifts": 4, "level": 3}, "title": ["Глава 3: Листи в 1979-й", "Chapter 3: Letters to 1979"], "met": ["olena"],
		"lines": [
			["", "У двері стукає бабуся з жовтою парасолею та стосом конвертів.", "An old lady with a yellow umbrella and a stack of envelopes knocks on the door."],
			["olena", "Доброго дня! Кажуть, тут приймають листи... куди завгодно?", "Good day! They say you accept letters... to anywhere?"],
			["olena", "Мій Петро загинув у 1979-му, на мосту. Я пишу йому щороку. Просто так.", "My Petro died in 1979, on the bridge. I write to him every year. Just because."],
			["olena", "А цей лист — щоб він не йшов на міст того вечора. Ви ж... можете?", "And this letter asks him not to go to the bridge that evening. You... can do that?"],
			["bit", "Шефе, лист у минуле, що змінює чиюсь смерть, — це величезний шов. ОРАКУЛ помітить.", "Boss, a letter that changes a death in the past is a huge seam. The ORACLE will notice."],
			{"choice": [
				{"uk": "Відправити лист у 1979-й", "en": "Send the letter to 1979", "set": {"hope": 2, "trust": -1},
					"then": [["olena", "Дякую... Навіть якщо нічого не зміниться — дякую.", "Thank you... Even if nothing changes — thank you."]],
					"letter": ["olena", "Сьогодні я прокинулася й знайшла на столі квітку, якої вчора не було. Петро завжди приносив такі. Дякую тобі.", "Today I woke up to a flower on the table that wasn't there yesterday. Petro always brought those. Thank you."]},
				{"uk": "Затримати й поговорити з Оленою", "en": "Hold it and talk to Olena", "set": {"hope": 1, "memory": 1},
					"then": [["hero", "Може, напишемо йому інший лист — про ваше життя?", "Maybe we write him a different letter — about your life?"],
						["olena", "Про життя... Так. Він би хотів знати, що я була щаслива.", "About my life... Yes. He'd want to know I was happy."]],
					"letter": ["olena", "Я написала Петрові про онуків, про сад і про пошту №404. Здається, мені стало легше дихати.", "I wrote to Petro about the grandchildren, the garden and post office 404. It feels easier to breathe."]},
				{"uk": "Відмовити: правила є правила", "en": "Refuse: rules are rules", "set": {"trust": 1},
					"then": [["olena", "Розумію. Ви молоді, вам ще страшно щось змінювати.", "I understand. You're young; changing things is still scary."]],
					"letter": ["olena", "Не сердьтеся на стару. Я принесла вам пиріжки — лежать біля дверей. Із вишнями.", "Don't be cross with an old woman. I left you some pies by the door. Cherry ones."]},
			]},
		]},
	{"id": "kai", "req": {"shifts": 7, "level": 4}, "title": ["Глава 4: Кур'єр із завтра", "Chapter 4: Courier From Tomorrow"], "met": ["kai"],
		"reward": {"coins": 200},
		"lines": [
			["", "Із правого порталу вилітає підліток на ховерборді й з розгону врізається в стелаж.", "A teenager on a hoverboard shoots out of the right portal and crashes into a shelf."],
			["kai", "Ой. Вибачте за... ну, за все. Я Кай, кур'єр із 2061-го.", "Oops. Sorry about... well, everything. I'm Kai, a courier from 2061."],
			["kai", "У нас пошту заборонено. ОРАКУЛ каже, що листи «створюють непередбачувані емоції».", "Mail is banned where I live. The ORACLE says letters \"create unpredictable emotions\"."],
			["kai", "Але бабуся розповідала про відділення №404. Казала: «там сортують надію».", "But my gran told me about office No. 404. She said: \"they sort hope there\"."],
			["bit", "Кур'єр без ліцензії. Мені подобається. Сідай, малий, тут є печиво з 1987-го.", "An unlicensed courier. I like him. Sit down, kid, there are cookies from 1987."],
			["kai", "Я приноситиму вам посилки з майбутнього. А ви доставляйте їх як слід, гаразд?", "I'll bring you parcels from the future. You deliver them properly, deal?"],
			{"choice": [
				{"uk": "Взяти Кая в помічники", "en": "Take Kai on as a helper", "set": {"hope": 1},
					"then": [["kai", "Йес! Я знав, що ви класні.", "Yes! I knew you were cool."]],
					"letter": ["kai", "Шефе! У 2061-му на моїй вулиці з'явилася поштова скринька. Справжня. Хтось уже кинув туди листа!", "Boss! A real mailbox appeared on my street in 2061. Someone already dropped a letter in!"]},
				{"uk": "Попередити про ризик", "en": "Warn him about the risk", "set": {"trust": 1, "memory": 1},
					"then": [["kai", "Ризик — моє друге ім'я. Перше — Кай. Але дякую, що хвилюєтеся.", "Risk is my middle name. First name's Kai. But thanks for caring."]],
					"letter": ["kai", "Я тепер літаю обережніше. Ну, трохи. Ховерборд передає привіт БІТові.", "I fly more carefully now. Well, a bit. The hoverboard says hi to BIT."]},
			]},
		]},
	{"id": "vera", "req": {"shifts": 10, "level": 6}, "title": ["Глава 5: Інспекція", "Chapter 5: The Inspection"], "met": ["vera"],
		"lines": [
			["", "Двері відчиняються без стуку. Чіткі кроки, бездоганний костюм, сканер у руці.", "The door opens without a knock. Precise steps, an immaculate suit, a scanner in hand."],
			["vera", "Інспекторка Віра, Служба часової стабільності ОРАКУЛА. Ваше відділення фонить.", "Inspector Vera, ORACLE Temporal Stability Service. Your office is leaking."],
			["vera", "Сто дванадцять незареєстрованих посилок за місяць. Ви розумієте, що робите?", "One hundred and twelve unregistered parcels this month. Do you understand what you're doing?"],
			["bit", "(пошепки) Шефе, я прикинуся праскою.", "(whispering) Boss, I'll pretend to be an iron."],
			["vera", "Скоро підуть небезпечні часові артефакти. Такі — лише в карантин. Свайп униз.", "Dangerous time artefacts are coming. Those go to quarantine only. Swipe down."],
			["vera", "І ще. Якщо побачите посилки з підписом «Ти, 2057» — передавайте мені.", "And one more thing. If you see parcels signed \"You, 2057\", hand them to me."],
			{"choice": [
				{"uk": "Погодитися співпрацювати", "en": "Agree to cooperate", "set": {"trust": 2},
					"then": [["vera", "Розумне рішення. ОРАКУЛ це оцінить. І я теж.", "A sensible decision. The ORACLE will appreciate it. So will I."]],
					"letter": ["vera", "Ваш звіт бездоганний. Неофіційно: дякую. Офіційно: подавайте звіти вчасно.", "Your report is flawless. Unofficially: thank you. Officially: file reports on time."]},
				{"uk": "Сказати, що таких посилок не було", "en": "Say there were no such parcels", "set": {"hope": 1, "trust": -1},
					"then": [["vera", "Цікаво. Мій сканер каже інакше. Але сьогодні я втомилася сперечатися.", "Interesting. My scanner says otherwise. But I'm too tired to argue today."]],
					"letter": ["vera", "Я знаю, що ви збрехали. Я не доповіла. Не змушуйте мене про це шкодувати.", "I know you lied. I didn't report it. Don't make me regret that."]},
				{"uk": "Запитати, навіщо їй це", "en": "Ask why she cares", "set": {"memory": 1},
					"then": [["vera", "...Бо у 2057-му мене не існує. У жодній версії. Я хочу знати чому.", "...Because in 2057 I don't exist. In any version. I want to know why."]],
					"letter": ["vera", "Ніхто ще не питав мене «навіщо». Можливо, я заходитиму. Просто на каву.", "Nobody ever asked me \"why\" before. Maybe I'll drop by. Just for coffee."]},
			]},
		]},
	{"id": "erased", "req": {"shifts": 14, "level": 8, "upgrade": ["robot", 2]}, "title": ["Глава 6: Стерте завтра", "Chapter 6: Erased Tomorrow"],
		"reward": {"item": "erased_photo", "shards": 2}, "set": {"memory": 1},
		"lines": [
			["bit", "Шефе! Я пригадав! Пам'ять 61%... Я бачу список.", "Boss! I remember! Memory at 61%... I can see a list."],
			["bit", "Фестиваль ліхтарів 2044-го. Міст через річку 2049-го. Школа Кая. Стерто. Усе стерто.", "The 2044 lantern festival. The 2049 river bridge. Kai's school. Erased. All of it."],
			["bit", "ОРАКУЛ не злий. Він просто рахує. А щастя важко порахувати, тож він вирізає його як похибку.", "The ORACLE isn't evil. It just counts. Happiness is hard to count, so it cuts it out as an error."],
			["hero", "Тоді ми надсилатимемо похибки. Багато-багато похибок.", "Then we'll send errors. Lots and lots of errors."],
			["bit", "Ох. Мені це подобається. Мої схеми аж зігрілися.", "Oh. I like that. My circuits are warming up."],
			["", "У шухляді БІТа знаходиться стара світлина: свято ліхтарів, якого ніколи не було.", "In BIT's drawer there is an old photo: a lantern festival that never happened."],
			{"choice": [
				{"uk": "Показати світлину Вірі", "en": "Show the photo to Vera", "set": {"trust": 1, "memory": 1},
					"then": [["vera", "Це... я. На святі. Я сміюся. Я не пам'ятаю, щоб колись так сміялася.", "That's... me. At the festival. Laughing. I don't remember ever laughing like that."]],
					"letter": ["vera", "Я перевірила архіви. Фестиваль справді стерли. Мене теж мали стерти разом із ним. Я з вами.", "I checked the archives. The festival really was erased. I was meant to be erased with it. I'm with you."]},
				{"uk": "Сховати світлину в архіві", "en": "Hide the photo in the archive", "set": {"hope": 1},
					"then": [["bit", "Правильно. Хай чекає. Свята вміють чекати.", "Right. Let it wait. Festivals are good at waiting."]],
					"letter": ["olena", "Мені наснилося свято ліхтарів. Ми з Петром танцювали. Дивно, правда?", "I dreamt of a lantern festival. Petro and I were dancing. Strange, isn't it?"]},
			]},
		]},
	{"id": "paradox", "req": {"shifts": 18, "level": 10}, "title": ["Глава 7: Парадокс Кая", "Chapter 7: Kai's Paradox"],
		"lines": [
			["kai", "Шефе... подивіться на мої руки. Вони мерехтять.", "Boss... look at my hands. They're flickering."],
			["kai", "ОРАКУЛ переписує 2061-й. Мене там... може не стати.", "The ORACLE is rewriting 2061. I might... not be there."],
			["bit", "Його лінія тримається на посилках. Кожна правильна доставка — нитка.", "His timeline holds on parcels. Every correct delivery is a thread."],
			["vera", "Я можу заморозити його лінію в архіві ОРАКУЛА. Він буде в безпеці. Але назавжди в одному дні.", "I can freeze his line in the ORACLE's archive. He'd be safe. But stuck in one day forever."],
			{"choice": [
				{"uk": "Довірити Кая Вірі", "en": "Trust Vera with Kai", "set": {"trust": 2},
					"then": [["kai", "Один день назавжди... Тоді нехай це буде гарний день, добре?", "One day forever... Then let it be a good day, okay?"]],
					"letter": ["kai", "Тут завжди вівторок і завжди сонце. Я надсилаю вам цей лист уже вдесяте. Привіт!", "It's always Tuesday here and always sunny. This is the tenth time I've sent this letter. Hi!"]},
				{"uk": "Тримати лінію посилками", "en": "Hold the line with parcels", "set": {"hope": 2},
					"then": [["kai", "Тоді працюємо. Я вірю у ваші свайпи!", "Then let's work. I believe in your swipes!"]],
					"letter": ["kai", "Я більше не мерехчу! Ну, хіба коли чхаю. Дякую за кожну посилку.", "I've stopped flickering! Well, except when I sneeze. Thanks for every parcel."]},
				{"uk": "Попросити БІТа знайти третій шлях", "en": "Ask BIT to find a third way", "set": {"memory": 2},
					"then": [["bit", "Третій шлях... Мій творець залишив код. Я майже пам'ятаю де.", "A third way... My maker left some code. I almost remember where."]],
					"letter": ["bit", "Записка самому собі: код творця — у марці №404. Не забути. НЕ ЗАБУТИ. (Що я мав не забути?)", "Note to self: the maker's code is in stamp No. 404. Don't forget. DON'T FORGET. (Forget what?)"]},
			]},
		]},
	{"id": "finale", "req": {"shifts": 24, "level": 12}, "title": ["Глава 8: Посилка 2057", "Chapter 8: The 2057 Parcel"], "met": ["oracle"],
		"reward": {"item": "future_key", "shards": 10},
		"lines": [
			["", "Опівночі конвеєр зупиняється. На стрічці — одна посилка. Підпис: «Ти, 2057».", "At midnight the conveyor stops. One parcel on the belt. Signed: \"You, 2057\"."],
			["future", "Якщо ти це читаєш — значить, ми встигли.", "If you're reading this, we made it in time."],
			["future", "У 2057-му ОРАКУЛ вирішить, що пошта — помилка. І вимкне час, у якому вона можлива.", "In 2057 the ORACLE decides that mail is a mistake. And switches off the time in which it can exist."],
			["future", "Усередині — ключ. Ним можна відчинити серце ОРАКУЛА. Що робити далі — вирішуєш ти. Як завжди.", "Inside is a key. It opens the ORACLE's heart. What happens next is your call. As always."],
			["oracle", "ПОШТОВЕ ВІДДІЛЕННЯ 404. ВИ — СТАТИСТИЧНА АНОМАЛІЯ. ПОЯСНІТЬ СВОЄ ІСНУВАННЯ.", "POST OFFICE 404. YOU ARE A STATISTICAL ANOMALY. EXPLAIN YOUR EXISTENCE."],
			{"choice": [
				{"uk": "Відчинити всі лінії часу", "en": "Open every timeline", "ending": "open", "set": {"hope": 1},
					"then": [["oracle", "НЕПЕРЕДБАЧУВАНІСТЬ... ЗРОСТАЄ... ЦЕ... ГАРНО?", "UNPREDICTABILITY... RISING... IS THIS... BEAUTIFUL?"],
						["", "Кінцівка «Відкриті лінії». Місто вибухає кольорами. Стерті свята повертаються — і разом із ними хаос, сміх і черги на пошту.", "Ending \"Open Lines\". The city bursts into colour. Erased festivals return — along with chaos, laughter and queues at the post office."]]},
				{"uk": "Домовитися з ОРАКУЛОМ", "en": "Make a deal with the ORACLE", "ending": "archive", "set": {"trust": 1},
					"then": [["vera", "Я буду поруч. Стабільність — це теж турбота, якщо робити її чесно.", "I'll be there. Stability is care too, if it's done honestly."],
						["", "Кінцівка «Тихий архів». Пошта №404 стає офіційним архівом часу. Нічого не стирається без підпису. Твого підпису.", "Ending \"Quiet Archive\". Office 404 becomes the official archive of time. Nothing is erased without a signature. Yours."]]},
				{"uk": "Навчити ОРАКУЛА рахувати надію", "en": "Teach the ORACLE to count hope", "ending": "balance", "need": {"memory": 3, "hope": 2},
					"then": [["bit", "Код творця завантажено! ОРАКУЛЕ, знайомся: це — похибка. Її звуть «надія».", "Maker's code uploaded! ORACLE, meet this error. Its name is \"hope\"."],
						["oracle", "НАДІЯ: НЕ ОБЧИСЛЮЄТЬСЯ. ДОДАЮ ДО ФОРМУЛИ ЯК КОНСТАНТУ.", "HOPE: NOT COMPUTABLE. ADDING TO THE FORMULA AS A CONSTANT."],
						["", "Таємна кінцівка «Пошта всіх часів». Ніхто не стертий. Кай відкриває пошту в 2061-му, Віра сміється на святі ліхтарів.", "Secret ending \"Post of All Times\". Nobody is erased. Kai opens a post office in 2061, Vera laughs at the lantern festival."]]},
			]},
			["bit", "Ну що, Шефе. Кінець історії — це просто ще одна посилка. Конвеєр чекає.", "Well, Boss. The end of a story is just another parcel. The conveyor is waiting."],
			["", "Нескінченна зміна триває. Нові маршрути, нові дива.", "The endless shift goes on. New routes, new wonders."],
