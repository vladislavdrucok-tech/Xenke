# Build archives for sharing (made from dist/; not tracked)
Afterfall_*.zip
qa/out/
Afterfall_*.apk

# Python bytecode from the art tools
godot/tools/__pycache__/
squad/tools/__pycache__/
iso/tools/__pycache__/
builds/*.idsig

# Deep Bounce: Godot cache, build output, signing material never goes to git
deep_bounce/.godot/
deep_bounce/build/
deep_bounce/tools/**/__pycache__/
*.keystore
*.jks
# Godot Android build template (installed by tools/android/build_release.sh) and plugin build output
deep_bounce/android/
deep_bounce/android_plugins/*/build/
deep_bounce/android_plugins/*/.gradle/
deep_bounce/android_plugins/*/*/build/
deep_bounce/android_plugins/*/local.properties
