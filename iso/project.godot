; Afterfall — isometric 2D yard of the Station (the visual direction from 03.11.2026 concept).
; Older prototypes: ../godot (side-view platformer), ../squad (top-down 3D squad).
config_version=5

[application]
config/name="Afterfall — Станція"
run/main_scene="res://main.tscn"
config/icon="res://icon.png"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]
window/size/viewport_width=960
window/size/viewport_height=442
window/size/window_width_override=1280
window/size/window_height_override=590
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]
pointing/emulate_touch_from_mouse=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.07, 0.08, 0.07, 1)
