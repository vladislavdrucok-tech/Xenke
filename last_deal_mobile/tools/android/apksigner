#!/usr/bin/env python3
"""Мінімальна заміна Android `apksigner` (sign / verify) для середовищ без Android SDK.

Реалізує APK Signature Scheme v2 (RSA PKCS#1 v1.5 + SHA-256, алгоритм 0x0103).
Підходить для Android 7.0+ (minSdk 24). Godot 4.3 викликає:
  apksigner sign --verbose --ks <keystore> --ks-pass pass:<пароль> --ks-key-alias <alias> <apk>
  apksigner verify --verbose <apk>
Ключ читається зі сховища PKCS#12 (keytool -storetype PKCS12).
Залежність: python3-cryptography.
"""
import hashlib
import struct
import sys

from cryptography import x509
from cryptography.hazmat.primitives import hashes
from cryptography.hazmat.primitives.asymmetric import padding
from cryptography.hazmat.primitives.serialization import Encoding, PublicFormat, pkcs12, load_der_public_key

APK_SIG_MAGIC = b"APK Sig Block 42"
V2_ID = 0x7109871A
ALG_RSA_PKCS1_SHA256 = 0x0103
CHUNK = 1024 * 1024


def lp(b: bytes) -> bytes:
    return struct.pack("<I", len(b)) + b


def read_lp(buf: bytes, off: int):
    n = struct.unpack_from("<I", buf, off)[0]
    return buf[off + 4: off + 4 + n], off + 4 + n


def find_eocd(data: bytes) -> int:
    start = len(data) - 22
    stop = max(-1, start - 65536 - 1)
    for i in range(start, stop, -1):
        if data[i:i + 4] == b"PK\x05\x06":
            clen = struct.unpack_from("<H", data, i + 20)[0]
            if i + 22 + clen == len(data):
                return i
    raise SystemExit("apksigner: EOCD not found — not a ZIP/APK")


def split_apk(data: bytes):
    """Повертає (contents, signing_block|None, central_dir, eocd)."""
    eocd_off = find_eocd(data)
    cd_size = struct.unpack_from("<I", data, eocd_off + 12)[0]
    cd_off = struct.unpack_from("<I", data, eocd_off + 16)[0]
    if cd_off + cd_size != eocd_off:
        raise SystemExit("apksigner: ZIP64 / unexpected layout not supported")
    block = None
    contents_end = cd_off
    if cd_off >= 32 and data[cd_off - 16:cd_off] == APK_SIG_MAGIC:
        size = struct.unpack_from("<Q", data, cd_off - 24)[0]
        bstart = cd_off - size - 8
        block = data[bstart:cd_off]
        contents_end = bstart
    return data[:contents_end], block, data[cd_off:eocd_off], data[eocd_off:]


def content_digest(contents: bytes, cd: bytes, eocd: bytes) -> bytes:
    e = bytearray(eocd)
    struct.pack_into("<I", e, 16, len(contents))  # зсув CD «як без блоку підпису»
    parts = []
    for sec in (contents, cd, bytes(e)):
        for off in range(0, len(sec), CHUNK):
            ch = sec[off:off + CHUNK]
            parts.append(hashlib.sha256(b"\xa5" + struct.pack("<I", len(ch)) + ch).digest())
    return hashlib.sha256(b"\x5a" + struct.pack("<I", len(parts)) + b"".join(parts)).digest()


def sign(apk: str, ks: str, password: str, alias: str, verbose: bool) -> None:
    with open(ks, "rb") as f:
        key, cert, extra = pkcs12.load_key_and_certificates(f.read(), password.encode())
    if key is None or cert is None:
        raise SystemExit("apksigner: no key/certificate in keystore")
    with open(apk, "rb") as f:
        data = f.read()
    contents, _old, cd, eocd = split_apk(data)
    digest = content_digest(contents, cd, eocd)
    cert_der = cert.public_bytes(Encoding.DER)
    signed_data = (
        lp(lp(struct.pack("<I", ALG_RSA_PKCS1_SHA256) + lp(digest)))
        + lp(lp(cert_der))
        + lp(b"")
    )
    signature = key.sign(signed_data, padding.PKCS1v15(), hashes.SHA256())
    pub = key.public_key().public_bytes(Encoding.DER, PublicFormat.SubjectPublicKeyInfo)
    signer = lp(signed_data) + lp(lp(struct.pack("<I", ALG_RSA_PKCS1_SHA256) + lp(signature))) + lp(pub)
    value = lp(lp(signer))
    pair = struct.pack("<Q", 4 + len(value)) + struct.pack("<I", V2_ID) + value
    bsize = len(pair) + 8 + 16
    block = struct.pack("<Q", bsize) + pair + struct.pack("<Q", bsize) + APK_SIG_MAGIC
    e = bytearray(eocd)
    struct.pack_into("<I", e, 16, len(contents) + len(block))
    with open(apk, "wb") as f:
        f.write(contents + block + cd + bytes(e))
    if verbose:
        print("Signed (APK Signature Scheme v2): %s" % apk)


def verify(apk: str, verbose: bool) -> int:
    with open(apk, "rb") as f:
        data = f.read()
    contents, block, cd, eocd = split_apk(data)
    if block is None:
        print("DOES NOT VERIFY: no APK Signing Block")
        return 1
    off = 8
    v2 = None
    while off < len(block) - 24:
        plen = struct.unpack_from("<Q", block, off)[0]
        pid = struct.unpack_from("<I", block, off + 8)[0]
        if pid == V2_ID:
            v2 = block[off + 12: off + 8 + plen]
        off += 8 + plen
    if v2 is None:
        print("DOES NOT VERIFY: no v2 signature")
        return 1
    signers, _ = read_lp(v2, 0)
    signer, _ = read_lp(signers, 0)
    sd, o = read_lp(signer, 0)
    sigs, o = read_lp(signer, o)
    pub_der, o = read_lp(signer, o)
    sig_el, _ = read_lp(sigs, 0)
    alg = struct.unpack_from("<I", sig_el, 0)[0]
    sig, _ = read_lp(sig_el, 4)
    if alg != ALG_RSA_PKCS1_SHA256:
        print("DOES NOT VERIFY: unsupported algorithm %x" % alg)
        return 1
    pub = load_der_public_key(pub_der)
    pub.verify(sig, sd, padding.PKCS1v15(), hashes.SHA256())
    digests, o2 = read_lp(sd, 0)
    certs, _ = read_lp(sd, o2)
    d_el, _ = read_lp(digests, 0)
    d_alg = struct.unpack_from("<I", d_el, 0)[0]
    d, _ = read_lp(d_el, 4)
    if d_alg != alg or d != content_digest(contents, cd, eocd):
        print("DOES NOT VERIFY: content digest mismatch")
        return 1
    cert_der, _ = read_lp(certs, 0)
    cert = x509.load_der_x509_certificate(cert_der)
    if cert.public_key().public_bytes(Encoding.DER, PublicFormat.SubjectPublicKeyInfo) != pub_der:
        print("DOES NOT VERIFY: certificate/public key mismatch")
        return 1
    if verbose:
        print("Verifies")
        print("Verified using v2 scheme (APK Signature Scheme v2): true")
        print("Signer #1 certificate DN: %s" % cert.subject.rfc4514_string())
    return 0


def main(argv) -> int:
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    if argv[0] == "--version":
        print("0.1-ld (v2 only)")
        return 0
    cmd = argv[0]
    args = argv[1:]
    verbose = "--verbose" in args or "-v" in args
    opts = {}
    rest = []
    i = 0
    while i < len(args):
        a = args[i]
        if a in ("--ks", "--ks-pass", "--ks-key-alias", "--key-pass", "--out", "--min-sdk-version", "--v1-signing-enabled",
                 "--v2-signing-enabled", "--v3-signing-enabled"):
            opts[a] = args[i + 1]
            i += 2
            continue
        if a.startswith("-"):
            i += 1
            continue
        rest.append(a)
        i += 1
    if not rest:
        print("apksigner: APK path missing")
        return 2
    apk = rest[-1]
    if cmd == "sign":
        pw = opts.get("--ks-pass", "pass:")
        if pw.startswith("pass:"):
            pw = pw[5:]
        elif pw.startswith("env:"):
            import os
            pw = os.environ.get(pw[4:], "")
        sign(apk, opts["--ks"], pw, opts.get("--ks-key-alias", ""), verbose)
        return verify(apk, False)
    if cmd == "verify":
        return verify(apk, verbose)
    print("apksigner: unknown command %s" % cmd)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
