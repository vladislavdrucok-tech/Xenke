; Pocket Triples — a pocket puzzle about freeing a five-slot tray by matching triples.
; Engine: Godot 4.3 (GL Compatibility). Open this file in Godot 4.3 or newer 4.x.
config_version=5

[application]

config/name="Pocket Triples"
config/name_localized={
"en": "Pocket Triples",
"uk": "Pocket Triples"
}
config/description="Pick the top tiles of four stacks, match triples and keep the five-slot tray free."
config/version="1.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
run/max_fps=60
boot_splash/bg_color=Color(0.968627, 0.941176, 0.882353, 1)
boot_splash/image="res://assets/art/splash.png"
boot_splash/fullsize=false
boot_splash/use_filter=true
config/icon="res://icon.png"

[autoload]

Store="*res://scripts/store.gd"
Sfx="*res://scripts/sfx.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[importer_defaults]

texture={
"mipmaps/generate": true
}

[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

locale/translations=PackedStringArray("res://translations/strings.en.translation", "res://translations/strings.uk.translation")
locale/fallback="en"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=3
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.968627, 0.941176, 0.882353, 1)
