; TIME POST: Parcels From Tomorrow (working title was POST 404) — portrait mobile 2D puzzle/sorting game.
; Engine: Godot 4.3, renderer: GL Compatibility (works on low-end Android).
config_version=5

[application]

config/name="Time Post"
; keep the old save folder so existing progress is found after the rename
config/use_custom_user_dir=true
config/custom_user_dir_name="POST 404"
config/description="Parcels From Tomorrow"
config/version="0.2.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://assets/sprites/icon.png"
run/low_processor_mode=false
config/quit_on_go_back=false
boot_splash/bg_color=Color(0.0627451, 0.0705882, 0.121569, 1)
boot_splash/show_image=false

[autoload]

I18n="*res://scripts/autoload/i18n.gd"
Audio="*res://scripts/autoload/audio.gd"
Game="*res://scripts/autoload/game.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=432
window/size/window_height_override=864
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/vsync/vsync_mode=1

[gui]

common/drop_mouse_on_gui_input_disabled=true

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=30

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.0627451, 0.0705882, 0.121569, 1)
2d/snap/snap_2d_transforms_to_pixel=true
