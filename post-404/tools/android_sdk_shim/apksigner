#!/bin/sh
# apksigner shim -> uber-apk-signer (zipalign + v1/v2/v3 signing)
JAR=$HOME/tools/uber-apk-signer.jar
cmd=$1; shift
case "$cmd" in --version|-version|version) echo "0.9"; exit 0;; esac
if [ "$cmd" = "verify" ]; then
  for a in "$@"; do apk=$a; done
  exec java -jar $JAR -a "$apk" --onlyVerify
fi
KS=""; PASS=""; ALIAS=""; APK=""
while [ $# -gt 0 ]; do
  case "$1" in
    --ks) KS=$2; shift 2;;
    --ks-pass) PASS=${2#pass:}; shift 2;;
    --ks-key-alias) ALIAS=$2; shift 2;;
    --key-pass) shift 2;;
    --verbose|-v) shift;;
    --*) shift 2;;
    *) APK=$1; shift;;
  esac
done
OUT=$(mktemp -d)
java -jar $JAR -a "$APK" --ks "$KS" --ksPass "$PASS" --ksAlias "$ALIAS" --ksKeyPass "$PASS" -o "$OUT" || exit 1
SIGNED=$(ls $OUT/*.apk | head -1)
mv "$SIGNED" "$APK"
rm -rf "$OUT"
