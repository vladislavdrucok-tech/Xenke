; Chicago: Blood & Loyalty — Godot 4.3 project (GL Compatibility). See docs/TECH_ARCHITECTURE.md.
; Separate from the old Afterfall prototypes in ../iso, ../squad, ../godot (left unchanged).
config_version=5

[application]

config/name="Chicago: Blood & Loyalty"
config/description="Narrative crime RPG, Chicago 1947 (Chapter 1 vertical slice)"
run/main_scene="res://core/boot.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"
config/use_custom_user_dir=true
config/custom_user_dir_name="chicago_blood_loyalty"
config/quit_on_go_back=false

[autoload]

EventBus="*res://core/event_bus.gd"
WorldClock="*res://core/world_clock.gd"
GameState="*res://core/game_state.gd"
SaveService="*res://core/save_service.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[gui]

theme/custom_font="res://art/fonts/LiberationSerif-Regular.ttf"
theme/default_font_antialiasing=1

