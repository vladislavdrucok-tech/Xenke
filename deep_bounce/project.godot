; Engine configuration file.
; Deep Bounce — Godot 4.5

config_version=5

[application]

config/name="Deep Bounce"
config/description="Swipe, bounce, dig deeper."
config/version="1.0.1"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.0313726, 0.168627, 0.188235, 1)
boot_splash/show_image=false
run/low_processor_mode=false
config/quit_on_go_back=false

[autoload]

G="*res://scripts/game_state.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[gui]

common/snap_controls_to_pixels=false

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.0313726, 0.168627, 0.188235, 1)
limits/opengl/max_renderable_lights=4
limits/opengl/max_lights_per_object=2
2d/snap/snap_2d_transforms_to_pixel=false

[debug]

gdscript/warnings/inference_on_variant=0
gdscript/warnings/untyped_declaration=0
