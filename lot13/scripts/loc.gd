func t(key: String, args: Dictionary = {}) -> String:
	var d: Dictionary = T.get(lang, T["en"])
	var s = d.get(key, null)
	if s == null:
		s = T["en"].get(key, key)
	var out := str(s)
	if not args.is_empty():
		out = out.format(args)
	return out


func set_lang(code: String) -> void:
	if not T.has(code):
		code = "en"
	if code == lang:
		return
	lang = code
	changed.emit()


func has_key(key: String) -> bool:
	return T["uk"].has(key) and T["en"].has(key)
